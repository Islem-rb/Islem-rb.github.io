---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Particles from '../components/Particles.astro';
import LangHint from '../components/LangHint.astro';
import { links, profile } from '../data/site';
import { getDict, languages, localize, toLang, unlocalize } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  // false on pages that exist in one language only (404).
  alternates?: boolean;
}

const lang = toLang(Astro.currentLocale);
const { meta, labels } = getDict(lang);
const { title = meta.title, description = meta.description, type = 'website', alternates = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const route = unlocalize(Astro.url.pathname);
// Person schema on the home pages (facts from cv.md).
const isHome = route === '/';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: getDict(lang).profile.role,
  url: new URL(localize(lang, '/'), Astro.site).href,
  image: ogImage.href,
  sameAs: [links.github, links.linkedin],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'ESPRIT' },
  knowsLanguage: ['ar', 'fr', 'en'],
};
const alternateUrls = languages.map((l) => ({ lang: l, href: new URL(localize(l, route), Astro.site).href }));
---

<!doctype html>
<html lang={meta.htmlLang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint. Light is the default, whatever the OS prefers.
      (function () {
        var theme = 'light';
        try {
          if (localStorage.getItem('theme') === 'dark') theme = 'dark';
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add('js');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates && [
        ...alternateUrls.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />),
        <link rel="alternate" hreflang="x-default" href={alternateUrls[0].href} />,
      ]
    }
    <meta name="theme-color" content="#f3f4f6" />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    {alternates && languages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={getDict(l).meta.ogLocale} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoWoff2} as="font" type="font/woff2" crossorigin />

  </head>
  <body class="min-h-dvh flex flex-col">
    <Particles />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink focus:font-mono focus:text-sm"
    >
      {labels.skipLink}
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    {alternates && <LangHint />}

    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
