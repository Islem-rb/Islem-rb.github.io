---
import BaseLayout from '../layouts/BaseLayout.astro';
// About page, shared by /about and /fr/about.
import { profile } from '../data/site';
import { cvEnMissing, cvHref, getDict, localize, toLang } from '../i18n';

const lang = toLang(Astro.currentLocale);
const t = getDict(lang);
const { aboutPage, skills: cvSkills, todos } = t;
const { items: experience, schools: education } = t.experience;
const cvFallback = lang === 'en' && cvEnMissing;

const blocks = [
  {
    id: 'experience',
    title: aboutPage.experienceTitle,
    entries: experience.map((e) => ({ period: e.period, title: e.role, org: e.org, bullets: e.bullets })),
  },
  {
    id: 'education',
    title: aboutPage.educationTitle,
    entries: education.map((e) => ({ ...e, bullets: [] as string[] })),
  },
];
---

<BaseLayout title={`${aboutPage.title} | ${profile.name}`}>
  <article class="mx-auto max-w-3xl px-4 pt-12 pb-20 sm:px-6 sm:pt-16 sm:pb-28">
    <a href={localize(lang, '/')} class="font-mono text-sm text-muted hover:text-accent"><span aria-hidden="true">← </span>{aboutPage.back}</a>

    <h1 class="mt-8 text-[clamp(2rem,5vw,3rem)] font-bold text-fg">{aboutPage.title}</h1>
    <div class="mt-6 space-y-2 text-[1.05rem] leading-relaxed text-fg/90">
      {aboutPage.lead.map((line) => <p>{line}</p>)}
    </div>
    <p class="mt-6 flex flex-wrap items-center gap-3">
      <a href={cvHref(lang)} class="font-medium text-accent hover:underline" download hreflang={cvFallback ? 'fr' : lang}>
        {cvFallback ? aboutPage.cvFallback : aboutPage.cv}
      </a>
      {cvFallback && <span class="todo">{todos.cvEn}</span>}
    </p>

    <section class="mt-14" aria-labelledby="skills-title">
      <h2 id="skills-title" class="text-2xl font-semibold text-fg">{aboutPage.skillsTitle}</h2>
      <dl class="mt-5 divide-y divide-line border-y border-line">
        {
          cvSkills.map((s) => (
            <div class="grid gap-1 py-3 sm:grid-cols-[14rem_1fr] sm:gap-6">
              <dt class="font-mono text-sm text-muted">{s.group}</dt>
              <dd class="text-fg/90">{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      blocks.map((block) => (
        <section class="mt-14" aria-labelledby={`${block.id}-title`}>
          <h2 id={`${block.id}-title`} class="text-2xl font-semibold text-fg">
            {block.title}
          </h2>
          <ul class="mt-5 space-y-5">
            {block.entries.map((e) => (
              <li>
                <p class="font-mono text-xs tracking-wider text-muted uppercase">{e.period}</p>
                <h3 class="mt-1 text-lg font-semibold text-fg">{e.title}</h3>
                <p class="text-muted">{e.org}</p>
                {e.bullets.length > 0 && (
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-fg/90 marker:text-accent">
                    {e.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="mt-14" aria-labelledby="languages-title">
      <h2 id="languages-title" class="text-2xl font-semibold text-fg">{aboutPage.languagesTitle}</h2>
      <p class="mt-4 text-fg/90">{t.profile.languages.join(', ')}</p>
    </section>
  </article>
</BaseLayout>
