---
import Icon from './Icon.astro';
import { labels, links, sections, todos } from '../data/site';

const { contact } = sections;
// TODO: set a Formspree endpoint (https://formspree.io/f/<id>) to send without leaving the page.
const formspree: string | null = null;

const channels = [
  { icon: 'email', label: links.email, href: `mailto:${links.email}`, external: false },
  { icon: 'linkedin', label: labels.linkedin, href: links.linkedin, external: true },
  { icon: 'github', label: labels.github, href: links.github, external: true },
] as const;

const field =
  'mt-1 w-full rounded-md border border-line bg-bg px-3.5 py-2 text-sm text-fg placeholder:text-muted/70 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/40';
---

<section id="contact" class="flex min-h-dvh items-center px-4 py-16 sm:px-6" aria-labelledby="contact-title">
  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 items-stretch gap-8 md:grid-cols-2 lg:gap-12">
    <div class="flex flex-col">
      <h2 id="contact-title" class="mb-3 text-[clamp(1.6rem,3vw,2.3rem)] leading-tight font-semibold text-fg">
        {contact.title[0]}<br />{contact.title[1]}
      </h2>
      <div class="flex flex-1 flex-col justify-center gap-6 rounded-2xl border border-line bg-surface p-5 sm:p-6 md:p-8">
        <p class="text-[1.05rem] leading-relaxed text-fg/90">{contact.text}</p>
        <ul class="flex flex-col gap-3">
          {
            channels.map((c) => (
              <li>
                <a
                  href={c.href}
                  class="inline-flex min-h-11 items-center gap-3 text-fg transition-colors hover:text-accent"
                  {...(c.external ? { target: '_blank', rel: 'me noopener' } : {})}
                >
                  <span class="flex size-10 items-center justify-center rounded-full border border-line">
                    <Icon name={c.icon} class="size-5" />
                  </span>
                  {c.label}
                  {c.external && <span class="sr-only">{labels.newTab}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-col">
      <p class="mb-3 hidden text-[clamp(1.6rem,3vw,2.3rem)] leading-tight md:block" aria-hidden="true">&nbsp;<br />&nbsp;</p>
      <div class="flex flex-1 flex-col justify-center rounded-2xl border border-line bg-surface p-5 sm:p-6 md:p-8">
        <form
          id="contact-form"
          class="flex flex-col gap-4"
          action={formspree ?? `mailto:${links.email}`}
          method="post"
          enctype={formspree ? undefined : 'text/plain'}
          data-mailto={formspree ? undefined : links.email}
          data-subject={contact.form.subject}
        >
          <div>
            <label for="contact-name" class="block text-sm font-bold text-fg">{contact.form.name}</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required class={field} />
          </div>
          <div>
            <label for="contact-email" class="block text-sm font-bold text-fg">{contact.form.email}</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required class={field} />
          </div>
          <div>
            <label for="contact-message" class="block text-sm font-bold text-fg">{contact.form.message}</label>
            <textarea id="contact-message" name="message" rows="3" required class:list={[field, 'resize-none']} placeholder={contact.form.placeholder}></textarea>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <button
              type="submit"
              class="min-h-11 cursor-pointer rounded-md bg-fg px-5 py-2 text-sm font-semibold text-bg transition-colors hover:bg-accent"
            >
              {contact.form.submit}
            </button>
            {!formspree && <span class="text-xs text-muted">{contact.form.note}</span>}
          </div>
          {!formspree && <p><span class="todo">{todos.formspree}</span></p>}
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // mailto fallback: build a clean email instead of the browser's raw text/plain post.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const to = form?.dataset.mailto;
  if (form && to) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name'));
      const subject = `${form.dataset.subject} ${name}`;
      const body = `${data.get('message')}\n\n${name}\n${data.get('email')}`;
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
