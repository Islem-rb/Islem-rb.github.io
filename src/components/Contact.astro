---
import SectionHeading from './SectionHeading.astro';
import { labels, links, sections } from '../data/site';

const channels = [
  {
    label: labels.email,
    value: links.email,
    href: `mailto:${links.email}`,
    icon: 'M4 6h16v12H4V6zm0 0l8 7 8-7',
    external: false,
  },
  {
    label: labels.github,
    value: links.github.replace('https://', ''),
    href: links.github,
    icon: 'M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
    external: true,
  },
  {
    label: labels.linkedin,
    value: links.linkedin.replace('https://www.', ''),
    href: links.linkedin,
    icon: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2V9zm2-3a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
    external: true,
  },
];
---

<section id="contact" class="relative isolate overflow-hidden border-t border-line/60" aria-labelledby="contact-title">
  <div class="contact-glow" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <SectionHeading id="contact-title" kicker={sections.contact.kicker} title={sections.contact.title} intro={sections.contact.text} />

    <ul class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-4 md:grid-cols-3">
      {
        channels.map((c, i) => (
          <li class="reveal min-w-0" style={`transition-delay:${i * 70}ms`}>
            <a
              href={c.href}
              class="card card-link group grid h-full grid-cols-[auto_1fr] items-center gap-x-4 gap-y-0.5 px-5 py-4 text-left md:flex md:flex-col md:gap-3 md:py-7 md:text-center"
              {...(c.external ? { target: '_blank', rel: 'me noopener' } : {})}
            >
              <span
                class="row-span-2 inline-flex size-12 items-center justify-center rounded-full border border-accent/40 text-accent transition-colors group-hover:bg-accent group-hover:text-accent-ink"
                aria-hidden="true"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={c.icon} />
                </svg>
              </span>
              <span class="font-mono text-sm font-bold text-fg">{c.label}</span>
              <span class="max-w-full font-mono text-xs break-all text-muted group-hover:text-accent">{c.value}</span>
              {c.external && <span class="sr-only">{labels.newTab}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(50% 60% at 50% 100%, color-mix(in oklab, var(--color-accent) 12%, transparent), transparent 70%);
  }
</style>
