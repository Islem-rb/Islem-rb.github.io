---
import { footer, labels, links, profile } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>
      <span class="text-accent">©</span>
      {`${year} ${profile.name}. ${footer.note}`}
    </p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      <li><a class="hover:text-accent" href={`mailto:${links.email}`}>{labels.email}</a></li>
      <li><a class="hover:text-accent" href={links.github} rel="me noopener" target="_blank">{labels.github}</a></li>
      <li><a class="hover:text-accent" href={links.linkedin} rel="me noopener" target="_blank">{labels.linkedin}</a></li>
      <li><a class="hover:text-accent" href="#top">{labels.backToTop}</a></li>
    </ul>
  </div>
</footer>
