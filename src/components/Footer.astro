---
import { links } from '../data/site';
import { cv, getDict, localize, toLang } from '../i18n';

const lang = toLang(Astro.currentLocale);
const { footer, labels } = getDict(lang);
const items = [
  { label: footer.about, href: localize(lang, '/about'), external: false },
  { label: footer.cv, href: cv[lang].href, external: false, cv: true },
  { label: labels.github, href: links.github, external: true },
  { label: labels.linkedin, href: links.linkedin, external: true },
];
---

<!-- Reference footer: dark band, centered links separated by bullets, 0.75rem / 0.875rem from sm,
     padding 1.5rem x 0.75rem (plus the bottom safe area). -->
<footer class="site-footer px-3 pt-6 pb-[calc(1.5rem+env(safe-area-inset-bottom))]">
  <nav aria-label={labels.footer}>
    <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs sm:text-sm">
      {
        items.map((item) => (
          <li class="flex items-center">
            <a
              href={item.href}
              class="inline-flex min-h-6 items-center"
              {...(item.external ? { target: '_blank', rel: 'me noopener' } : {})}
              {...(item.cv ? { download: cv[lang].file, hreflang: lang, type: 'application/pdf', 'data-cv-link': '' } : {})}
            >
              {item.label}
              {item.external && <span class="sr-only">{labels.newTab}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-footer-bg);
    color: var(--color-footer-fg);
  }
  /* Bullet separators, silent for screen readers (empty alt text). */
  li + li::before {
    content: '•' / '';
    margin-right: 1rem;
  }
  /* 24px tap target (WCAG 2.5.8) that overflows the line instead of growing the band, so the
     footer keeps the reference's height (68px, 64px below sm). */
  a {
    margin-block: calc((1lh - 24px) / 2);
    transition: color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  a:hover,
  a:focus-visible {
    color: var(--color-footer-hover);
  }
  a:focus-visible {
    outline-color: var(--color-footer-hover);
  }
</style>
