---
import { Image } from 'astro:assets';
import Placeholder from '../assets/profile-placeholder.svg';
import Tools from './Tools.astro';
import CvLink from './CvLink.astro';
import { getDict, localize, toLang } from '../i18n';

const lang = toLang(Astro.currentLocale);
const { about, pages, todos } = getDict(lang);

// Drop src/assets/profile.{jpg,jpeg,png,webp} in place and it replaces the placeholder.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/profile.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photos)[0]?.default;
---

<section id="about" data-bg="about" data-page={pages.about} class="flex min-h-dvh flex-col items-center justify-center gap-16 px-4 py-16 sm:px-6" aria-label={pages.about}>
  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-10 md:grid-cols-2">
    <div class="flex flex-col items-center gap-8 text-center">
      <!-- Two-word tagline like the reference: one word per line, accent periods. An h2 under the
           page's h1; the section itself is named "About" (aria-label). -->
      <h2 class="text-[clamp(1.8rem,3vw,2.5rem)] leading-tight font-semibold tracking-normal text-fg">
        {about.title[0]}<span class="text-accent">.</span><br />{about.title[1]}<span class="text-accent">.</span>
      </h2>
      <div class="flex flex-col items-center gap-3">
        <div class="size-48 overflow-hidden rounded-full shadow-lg ring-2 ring-accent/60 md:size-56">
          {
            photo ? (
              <Image src={photo} alt={about.photoAlt} width={448} height={448} class="size-full object-cover" />
            ) : (
              <Placeholder class="placeholder size-full" aria-hidden="true" />
            )
          }
        </div>
        {!photo && <span class="todo">{todos.photo}</span>}
      </div>
    </div>

    <div class="flex flex-col items-start gap-8">
      <p class="text-[1.05rem] leading-relaxed text-fg/90">
        {about.intro}
        <br /><br />
        <a href={localize(lang, '/about')} class="group inline-flex items-center gap-2 font-medium text-accent italic hover:underline">
          {about.link}
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </p>
      <CvLink class="btn">{about.cv}</CvLink>
    </div>
  </div>
  <div class="mx-auto w-full max-w-6xl">
    <Tools />
  </div>
</section>

<style>
  /* The placeholder SVG is inlined, so its shapes follow the theme colors. */
  :global(.placeholder rect) {
    fill: var(--color-surface-2);
  }
  :global(.placeholder circle),
  :global(.placeholder path) {
    fill: var(--color-line);
  }
</style>
