---
interface Props {
  id: string;
  kicker: string;
  title: string;
  intro?: string;
}

const { id, kicker, title, intro } = Astro.props;
---

<header class="reveal mx-auto max-w-2xl text-center">
  <p class="section-kicker">{kicker}</p>
  <h2 id={id} class="section-title mt-3">{title}</h2>
  {intro && <p class="mt-4 text-muted">{intro}</p>}
</header>
