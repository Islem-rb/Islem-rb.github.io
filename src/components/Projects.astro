---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import { sections } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const [flagship, ...rest] = projects;
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28" aria-labelledby="projects-title">
  <SectionHeading id="projects-title" {...sections.projects} />

  <ol class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
    <li class="reveal min-w-0 md:col-span-2 lg:col-span-3">
      <ProjectCard project={flagship} index={0} />
    </li>
    {
      rest.map((p, i) => (
        <li class="reveal min-w-0" style={`transition-delay:${(i + 1) * 70}ms`}>
          <ProjectCard project={p} index={i + 1} />
        </li>
      ))
    }
  </ol>
</section>
