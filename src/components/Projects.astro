---
import { getCollection } from 'astro:content';
import { pages, sections } from '../data/site';

// Collection order (flagship first); the flagship card spans the full row.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const { projects: t } = sections;
---

<section id="projects" data-page={pages.projects} class="flex min-h-dvh items-center px-4 py-16 sm:px-6 md:py-20" aria-labelledby="projects-title">
  <div class="mx-auto w-full max-w-6xl">
    <h2 id="projects-title" class="mb-10 text-center text-[clamp(1.8rem,3vw,2.5rem)] leading-tight font-semibold text-fg md:mb-12">
      {t.title}
    </h2>

    <ol class="grid gap-5 lg:grid-cols-3 lg:gap-6">
      {
        projects.map((p, i) => {
          const featured = p.data.featured;
          const titleId = `project-${p.id}`;
          return (
            <li class:list={['card-item reveal', featured && 'lg:col-span-3']} style={`--delay: ${i * 120}ms`}>
              <article class:list={['project', featured && 'project--featured']} aria-labelledby={titleId}>
                <div class="head">
                  <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <p class="meta">
                    <span class="year">{p.data.inProgress ? t.inProgress : p.data.year}</span>
                    {p.data.kind && <span class="kind">{p.data.kind}</span>}
                  </p>
                </div>
                <div class="body">
                  <div>
                    <h3 id={titleId} class="title">{p.data.title}</h3>
                    <p class="summary">{p.data.summary}</p>
                  </div>
                  <div class="aside">
                    <ul class="tech" aria-label={t.stack}>
                      {(featured ? p.data.stack : p.data.stack.slice(0, 4)).map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                    <a href={`/projects/${p.id}`} class="cta" aria-label={`${t.cta}: ${p.data.title}`}>
                      {t.cta}
                    </a>
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .card-item {
    display: flex;
  }
  /* Same card language as before: accent edge on the left, asymmetric radius, soft shadow. */
  .project {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.375rem 1.375rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 18%, transparent);
    border-left: 3px solid var(--color-accent);
    border-radius: 1.05rem 1.05rem 1.05rem 0.35rem;
    background: color-mix(in oklab, var(--color-surface) 90%, transparent);
    box-shadow: var(--shadow-card);
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s var(--ease-out-soft);
  }
  .project:hover,
  .project:focus-within {
    border-top-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    border-right-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    border-bottom-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    box-shadow: var(--shadow-window);
    transform: translateY(-2px);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .num {
    display: flex;
    width: 2.125rem;
    height: 2.125rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-accent);
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .year {
    color: var(--color-accent);
  }
  .kind {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-muted);
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }
  .title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-fg);
  }
  .summary {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
  }
  .tech li {
    padding: 0.2rem 0.65rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 22%, transparent);
    border-radius: 999px;
    background: var(--color-surface-2);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .cta {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  /* The whole card is the click target; the link itself stays the only focus stop. */
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .cta::after {
    content: '→';
    display: inline-block;
    margin-left: 0.35rem;
    transition: transform 0.25s var(--ease-out-soft);
  }
  .project:hover .cta::after {
    transform: translateX(4px);
  }
  .cta:focus-visible {
    outline: none;
  }
  .project:has(.cta:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Flagship: larger title, summary and full stack side by side on wide screens. */
  .project--featured .title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  .project--featured .summary {
    font-size: 1rem;
  }
  @media (min-width: 64rem) {
    .project--featured {
      padding: 1.75rem 2rem 1.875rem;
      background:
        radial-gradient(40rem 14rem at 100% 0%, color-mix(in oklab, var(--color-accent) 8%, transparent), transparent),
        color-mix(in oklab, var(--color-surface) 90%, transparent);
    }
    .project--featured .body {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 2.5rem;
      align-items: end;
    }
  }

  /* Phones: each card snaps to the middle of the screen. */
  @media (max-width: 767px) and (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    .card-item {
      scroll-snap-align: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project:hover,
    .project:focus-within {
      transform: none;
    }
  }
</style>
