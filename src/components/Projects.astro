---
import { getDict, getProjects, localize, toLang } from '../i18n';

// Zig-zag timeline with the reference's "parcours" layout and spacing (measured in Playwright,
// see refs/NOTES.md): a central rail with one dot per project, cards alternating left and right,
// number and year on the outer side of each card, one row per project with 2.5rem between rows.
// Collection order, flagship first. Below 768px it becomes one column along a left rail.
const lang = toLang(Astro.currentLocale);
const { pages, projects: t } = getDict(lang);
const projects = await getProjects(lang);
---

<section id="projects" data-page={pages.projects} class="flex min-h-dvh items-center px-4 py-16 sm:px-6" aria-labelledby="projects-title">
  <div class="mx-auto w-full max-w-5xl">
    <h2 id="projects-title" class="mb-10 text-center text-[clamp(1.8rem,3vw,2.5rem)] leading-tight font-semibold text-fg md:mb-12">
      {t.title}<span class="text-accent" aria-hidden="true">.</span>
    </h2>

    <ol class="track" style={`--count: ${projects.length}`}>
      {
        projects.map((p, i) => {
          const side = i % 2 === 0 ? 'left' : 'right';
          const titleId = `project-${p.id}`;
          const num = String(i + 1).padStart(2, '0');
          return (
            <li class:list={['item', `item--${side}`, p.data.featured && 'item--featured']} style={`--i: ${i}`}>
              <span class="marker" aria-hidden="true" />
              <div class={`reveal side side--${side}`} style={`--delay: ${i * 120}ms`}>
                <p class="period">
                  <span class="num-inline" aria-hidden="true">
                    {num}
                  </span>
                  {p.data.inProgress ? t.inProgress : p.data.year}
                </p>
                <article class="card" aria-labelledby={titleId}>
                  {p.data.kind && <p class="context">{p.data.kind}</p>}
                  <h3 id={titleId} class="title">
                    {p.data.title}
                  </h3>
                  <ul class="tech" aria-label={t.stack}>
                    {p.data.stack.slice(0, 4).map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                  <p class="summary">{p.data.summary}</p>
                  <ul class="highlights" aria-label={t.highlights}>
                    {p.data.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                  <a href={localize(lang, `/projects/${p.id}`)} class="cta" aria-label={`${t.cta}: ${p.data.title}`}>
                    {t.cta}
                  </a>
                </article>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .track {
    position: relative;
    list-style: none;
    padding: 0;
  }

  /* ---- Phones: one column along a left rail. ---- */
  .item {
    position: relative;
    padding-left: 1.15rem;
  }
  .item + .item {
    margin-top: 2rem;
  }
  .item::before {
    content: '';
    position: absolute;
    top: 0.35rem;
    bottom: -2rem;
    left: 0;
    width: 2px;
    border-radius: 2px;
    background: color-mix(in oklab, var(--color-accent) 35%, transparent);
  }
  .item:last-child::before {
    bottom: 0.5rem;
  }
  .marker {
    display: none;
  }
  .period {
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .num-inline {
    margin-right: 0.6rem;
    font-family: var(--font-mono);
    color: var(--color-muted);
  }

  /* ---- Card ---- */
  .card {
    position: relative;
    padding: 1.2rem 1.35rem 1.3rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 18%, transparent);
    border-left: 3px solid var(--color-accent);
    border-radius: 1.05rem 1.05rem 1.05rem 0.35rem;
    background: color-mix(in oklab, var(--color-surface) 90%, transparent);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(8px);
    transition:
      transform 0.35s var(--ease-out-soft),
      box-shadow 0.35s,
      border-color 0.35s;
  }
  .card:hover,
  .card:focus-within {
    border-top-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    border-bottom-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    box-shadow: var(--shadow-window);
    transform: translateY(-3px);
  }
  .item--left .card:hover,
  .item--left .card:focus-within {
    border-right-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
  }
  .item--right .card:hover,
  .item--right .card:focus-within {
    border-left-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
  }
  .context {
    margin-bottom: 0.5rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .title {
    margin-bottom: 0.75rem;
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    font-weight: 600;
    line-height: 1.28;
    color: var(--color-fg);
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.7rem;
    list-style: none;
    padding: 0;
  }
  .tech li {
    padding: 0.28rem 0.65rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 22%, transparent);
    border-radius: 999px;
    background: var(--color-surface-2);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .summary {
    margin-bottom: 0.85rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .highlights {
    margin-bottom: 0.85rem;
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-fg);
  }
  .highlights li {
    position: relative;
    padding-left: 1.1rem;
  }
  .highlights li::before {
    content: '>';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  /* The whole card is the click target; the link stays the only focus stop. */
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .cta::after {
    content: '→';
    transition: transform 0.25s var(--ease-out-soft);
  }
  .card:hover .cta::after {
    transform: translateX(4px);
  }
  .cta:focus-visible {
    outline: none;
  }
  .card:has(.cta:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* ---- 768px and up: central rail, cards alternate sides and overlap by half a card. ---- */
  @media (min-width: 48rem) {
    .track {
      display: grid;
      grid-template-columns: 1fr 3.5rem 1fr;
      row-gap: 2.5rem;
    }
    .track::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 2px;
      margin-left: -1px;
      border-radius: 2px;
      pointer-events: none;
      background: linear-gradient(
        180deg,
        transparent 0%,
        color-mix(in oklab, var(--color-accent) 55%, transparent) 8%,
        color-mix(in oklab, var(--color-accent) 40%, transparent) 50%,
        color-mix(in oklab, var(--color-accent) 55%, transparent) 92%,
        transparent 100%
      );
    }
    /* One row per project, like the reference (no overlap between consecutive cards). */
    .item {
      grid-row: calc(var(--i) + 1);
      padding-left: 0;
    }
    .item + .item {
      margin-top: 0;
    }
    .item::before {
      display: none;
    }
    .item--left {
      grid-column: 1;
    }
    .item--right {
      grid-column: 3;
    }
    /* Rail dot: 0.85rem, 2px ring, 1.85rem below the card's top edge (reference). */
    .marker {
      position: absolute;
      top: 1.85rem;
      z-index: 1;
      display: block;
      width: 0.85rem;
      height: 0.85rem;
      border: 2px solid var(--color-accent);
      border-radius: 50%;
      background: var(--color-bg-from);
      box-shadow:
        0 0 0 4px color-mix(in oklab, var(--color-bg-from) 88%, transparent),
        0 0 20px color-mix(in oklab, var(--color-accent) 35%, transparent);
      transition: transform 0.35s var(--ease-out-soft);
    }
    /* Centered on the rail: half the 3.5rem gutter plus half the dot. */
    .item--left .marker {
      right: -2.175rem;
    }
    .item--right .marker {
      left: -2.175rem;
    }
    .item:hover .marker,
    .item:focus-within .marker {
      transform: scale(1.2);
    }
    /* Number on its own line above the year. */
    .num-inline {
      display: block;
      margin: 0 0 0.2rem;
    }
    .side {
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .side--left {
      justify-content: flex-end;
    }
    .side--right {
      flex-direction: row-reverse;
      justify-content: flex-end;
    }
    .period {
      flex: none;
      max-width: 5.75rem;
      margin: 0;
      padding-top: 1.35rem;
      line-height: 1.25;
    }
    .side--right .period {
      text-align: right;
    }
    .card {
      flex: 0 1 auto;
      width: 100%;
      max-width: 26rem;
    }
    .item--right .card {
      border-left-width: 1px;
      border-right: 3px solid var(--color-accent);
      border-radius: 1.05rem 1.05rem 0.35rem 1.05rem;
    }
  }

  /* No per-card snap points: the section is taller than the screen, so it scrolls freely inside
     and the page snap takes over at its edges (a card snap point trapped short swipes). */
  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-within,
    .item:hover .marker {
      transform: none;
    }
  }
</style>
