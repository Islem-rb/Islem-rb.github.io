---
import TerminalCard from './TerminalCard.astro';
import { hero, links, profile } from '../data/site';
---

<section id="top" class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-6xl flex-col items-center px-4 pt-14 pb-20 text-center sm:px-6 sm:pt-24 sm:pb-28">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-xs text-accent"
    >
      <span class="relative flex size-2" aria-hidden="true">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:animate-none"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      {profile.availability}
    </p>

    <h1 id="hero-title" class="hero-name mt-6 text-[clamp(2.5rem,8vw,4.5rem)] font-extrabold">
      {profile.name}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-fg/90 sm:text-xl">{profile.role}</p>
    <p class="mt-2 max-w-2xl text-sm text-muted sm:text-base">{profile.focus}</p>

    <div class="mt-8 flex w-full flex-col items-stretch justify-center gap-3 sm:w-auto sm:flex-row sm:items-center">
      <a href="#projects" class="btn btn-primary">{hero.ctas.projects}</a>
      <a href={links.cv} class="btn" download>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14"></path></svg
        >
        {hero.ctas.cv}
      </a>
      <a href="#contact" class="btn">{hero.ctas.contact}</a>
    </div>

    <div class="mt-14 w-full sm:mt-16">
      <TerminalCard />
    </div>
  </div>
</section>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 50% 0%, color-mix(in oklab, var(--color-accent) 14%, transparent), transparent 70%),
      linear-gradient(to right, color-mix(in oklab, var(--color-line) 45%, transparent) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(to bottom, color-mix(in oklab, var(--color-line) 45%, transparent) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: radial-gradient(75% 65% at 50% 25%, black, transparent);
  }
  .hero-name {
    background: linear-gradient(100deg, var(--color-fg) 35%, var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
