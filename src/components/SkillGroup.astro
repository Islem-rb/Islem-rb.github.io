---
interface Props {
  title: string;
  icon: 'cloud' | 'box' | 'flow' | 'pulse' | 'code';
  items: readonly string[];
}

const { title, icon, items } = Astro.props;

const paths: Record<Props['icon'], string> = {
  cloud: 'M7 18a4 4 0 0 1-.5-7.97A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9H7z',
  box: 'M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3zm0 0v18m8-13.5l-8 4.5-8-4.5',
  flow: 'M6 3v12m0 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm12-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm0 0a9 9 0 0 1-9 9',
  pulse: 'M3 12h4l3-8 4 16 3-8h4',
  code: 'M8 8l-4 4 4 4m8-8l4 4-4 4m-6 3l4-14',
};
---

<article class="card card-link h-full p-5 sm:p-6">
  <div class="flex items-center gap-3">
    <span
      class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent"
      aria-hidden="true"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d={paths[icon]}></path>
      </svg>
    </span>
    <h3 class="text-base font-bold text-fg">{title}</h3>
  </div>
  <ul class="mt-5 flex flex-wrap gap-2">
    {
      items.map((item) => (
        <li class="rounded-md border border-line bg-bg/60 px-2.5 py-1 font-mono text-xs text-fg/90 transition-colors hover:border-accent/50 hover:text-accent">
          {item}
        </li>
      ))
    }
  </ul>
</article>
