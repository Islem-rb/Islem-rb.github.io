---
import { getDict, toLang } from '../i18n';

const { labels } = getDict(toLang(Astro.currentLocale));

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- Sun/moon switch. aria-pressed = dark theme on. The state is set by the head script before paint. -->
<button
  type="button"
  class:list={['theme-toggle', className]}
  aria-pressed="false"
  aria-label={labels.darkTheme}
  title={labels.darkTheme}
  data-theme-toggle
>
  <span class="knob" aria-hidden="true"></span>
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" />
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 3.5rem;
    height: 2rem;
    padding: 0 0.4rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-muted);
    cursor: pointer;
    transition: border-color 0.3s, background-color 0.3s;
  }
  .theme-toggle:hover {
    border-color: var(--color-accent);
  }
  /* 44px touch target without changing the visual size. */
  .theme-toggle::after {
    content: '';
    position: absolute;
    inset: -6px -2px;
  }
  .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: 0 1px 3px rgb(15 23 42 / 0.25);
    transition: transform 0.3s var(--ease-out-soft);
  }
  .icon {
    position: relative;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sun {
    margin-left: 0.05rem;
    color: var(--color-fg);
  }
  :global([data-theme='dark']) .knob {
    transform: translateX(1.5rem);
  }
  :global([data-theme='dark']) .sun {
    color: var(--color-muted);
  }
  :global([data-theme='dark']) .moon {
    color: var(--color-fg);
  }
</style>

<script>
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(dark));
    });
    meta?.setAttribute('content', dark ? '#1f2937' : '#f3f4f6');
  };
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
    b.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage blocked (private mode): the choice lasts for this page only.
      }
      sync();
    });
  });
  sync();
</script>
