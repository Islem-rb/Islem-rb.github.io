---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import SkillsWindow from './SkillsWindow.astro';
import LangSwitch from './LangSwitch.astro';
import { links, profile } from '../data/site';
import { getDict, localize, toLang, unlocalize } from '../i18n';

// Home: the first page (name, role line, three round links, skills.txt window).
// Sub-pages: the same links in a compact bar.
const lang = toLang(Astro.currentLocale);
const { labels, pages, profile: localProfile } = getDict(lang);
const home = localize(lang, '/');
const isHome = unlocalize(Astro.url.pathname).replace(/\/$/, '') === '';

const items = [
  { name: 'email', label: labels.contact, href: isHome ? '#contact' : `${home}#contact`, external: false },
  { name: 'linkedin', label: labels.linkedin, href: links.linkedin, external: true },
  { name: 'github', label: labels.github, href: links.github, external: true },
] as const;

// Sub-pages: text links back to the home sections.
const sectionLinks = [
  { label: labels.projects, href: `${home}#projects` },
  { label: labels.experience, href: `${home}#experience` },
  { label: labels.contact, href: `${home}#contact` },
];
---

{
  isHome ? (
    <header
      id="top"
      data-page={pages.home}
      class="hero-halo relative flex min-h-dvh flex-col items-center px-6 pt-[clamp(7rem,24vh,14.5rem)] pb-12 text-center [@media(max-height:50rem)]:pt-[max(4rem,15vh)] [@media(max-height:50rem)]:pb-6"
    >
      <div class="absolute top-4 right-4 z-50 flex items-center gap-3 md:fixed">
        <LangSwitch />
        <ThemeToggle />
      </div>
      <h1 class="reveal hero-name font-bold leading-none text-[clamp(2.75rem,6vw,4rem)]" style="--delay: 0ms">
        {profile.name}
      </h1>
      <p class="reveal mt-6 text-lg font-light text-muted sm:text-xl md:text-2xl" style="--delay: 150ms">
        {localProfile.role}
      </p>
      <ul class="mt-16 flex items-center justify-center gap-8 [@media(max-height:50rem)]:mt-10">
        {items.map((item, i) => (
          <li class="reveal" style={`--delay: ${300 + i * 150}ms`}>
            <a
              href={item.href}
              aria-label={item.external ? `${item.label} ${labels.newTab}` : item.label}
              class="flex size-20 items-center justify-center rounded-full border-2 border-fg/80 text-fg transition-colors duration-300 hover:border-accent hover:text-accent"
              {...(item.external ? { target: '_blank', rel: 'me noopener' } : {})}
            >
              <Icon name={item.name} class={item.name === 'email' ? 'size-10' : 'size-9'} />
            </a>
          </li>
        ))}
      </ul>
      <SkillsWindow />
    </header>
  ) : (
    <header id="top" class="border-b border-line">
      <nav aria-label={labels.main} class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 px-4 sm:px-6">
        <a href={home} class="flex min-h-16 items-center font-semibold text-fg hover:text-accent">
          {profile.name}
        </a>
        <ul class="order-last flex w-full gap-6 border-t border-line text-sm sm:order-none sm:w-auto sm:border-0">
          {sectionLinks.map((l) => (
            <li>
              <a href={l.href} class="flex min-h-11 items-center text-muted transition-colors hover:text-accent">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        <ul class="flex items-center gap-1">
          <li class="mr-2 flex items-center gap-3">
            <LangSwitch />
            <ThemeToggle />
          </li>
          {items.slice(1).map((item) => (
            <li>
              <a
                href={item.href}
                aria-label={`${item.label} ${labels.newTab}`}
                class="flex size-11 items-center justify-center rounded-full text-muted transition-colors hover:text-accent"
                target="_blank"
                rel="me noopener"
              >
                <Icon name={item.name} class="size-5" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
  )
}

<style>
  /* Accent glow in the top-right corner, like the reference hero. */
  .hero-halo::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 100dvh;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(30rem 80rem at 100% 0%, var(--halo), transparent 90%);
    /* Fade out before the layer's bottom edge so no seam shows. */
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }
  .hero-name {
    letter-spacing: -0.01em;
    color: transparent;
    background: linear-gradient(90deg, var(--color-fg), var(--color-accent));
    background-clip: text;
    -webkit-background-clip: text;
  }
</style>
