---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { labels, links, profile } from '../data/site';

// Home: large centered name, role line and three round links.
// Sub-pages: the same links in a compact bar.
const isHome = Astro.url.pathname === '/';

const items = [
  { name: 'email', label: labels.contact, href: isHome ? '#contact' : '/#contact', external: false },
  { name: 'linkedin', label: labels.linkedin, href: links.linkedin, external: true },
  { name: 'github', label: labels.github, href: links.github, external: true },
] as const;
---

{
  isHome ? (
    <header id="top" class="hero-halo relative flex flex-col items-center px-6 pt-[clamp(7rem,24vh,14.5rem)] text-center">
      <ThemeToggle class="!fixed top-4 right-4 z-50" />
      <h1 class="hero-name font-bold leading-none text-[clamp(2.75rem,6vw,4rem)]">{profile.name}</h1>
      <p class="mt-6 text-lg font-light text-muted sm:text-xl md:text-2xl">{profile.role}</p>
      <ul class="mt-16 flex items-center justify-center gap-8">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-label={item.external ? `${item.label} ${labels.newTab}` : item.label}
              class="flex size-20 items-center justify-center rounded-full border-2 border-fg/80 text-fg transition-colors duration-300 hover:border-accent hover:text-accent"
              {...(item.external ? { target: '_blank', rel: 'me noopener' } : {})}
            >
              <Icon name={item.name} class={item.name === 'email' ? 'size-10' : 'size-9'} />
            </a>
          </li>
        ))}
      </ul>
    </header>
  ) : (
    <header id="top" class="border-b border-line">
      <nav aria-label="Main" class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
        <a href="/" class="font-semibold text-fg hover:text-accent">
          {profile.name}
        </a>
        <ul class="flex items-center gap-2">
          <li class="mr-2 flex items-center">
            <ThemeToggle />
          </li>
          {items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-label={item.external ? `${item.label} ${labels.newTab}` : item.label}
                class="flex size-11 items-center justify-center rounded-full text-muted transition-colors hover:text-accent"
                {...(item.external ? { target: '_blank', rel: 'me noopener' } : {})}
              >
                <Icon name={item.name} class="size-5" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
  )
}

<style>
  /* Accent glow in the top-right corner, like the reference hero. */
  .hero-halo::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 100dvh;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(30rem 80rem at 100% 0%, var(--halo), transparent 90%);
    /* Fade out before the layer's bottom edge so no seam shows. */
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }
  .hero-name {
    letter-spacing: -0.01em;
    color: transparent;
    background: linear-gradient(90deg, var(--color-fg), var(--color-accent));
    background-clip: text;
    -webkit-background-clip: text;
  }
</style>
