---
import { getCollection } from 'astro:content';
import { pages, sections, timelineExtra } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Newest first; Array.sort is stable, so equal years keep the collection order.
const entries = [
  ...projects.map((p) => ({
    year: p.data.year,
    inProgress: p.data.inProgress,
    context: p.data.kind ?? '',
    title: p.data.title,
    tech: p.data.stack.slice(0, 4),
    summary: p.data.summary,
    href: `/projects/${p.id}`,
  })),
  ...timelineExtra.map((e) => ({ ...e, inProgress: false, href: null })),
].sort((a, b) => Number(b.year) - Number(a.year));
---

<section id="projects" data-page={pages.projects} class="px-4 py-16 sm:px-6 md:py-24" aria-labelledby="projects-title">
  <div class="mx-auto w-full max-w-5xl">
    <h2 id="projects-title" class="mb-10 text-center text-[clamp(1.8rem,3vw,2.5rem)] leading-tight font-semibold text-fg md:mb-12">
      {sections.projects.title}
    </h2>

    <ol class="track">
      {
        entries.map((e, i) => {
          const side = i % 2 === 0 ? 'left' : 'right';
          const Card = e.href ? 'a' : 'div';
          return (
            <li class:list={['item reveal', `item--${side}`]}>
              <span class="num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="side">
                <p class="period">
                  {e.inProgress ? sections.projects.inProgress : e.year}
                </p>
                <Card href={e.href ?? undefined} class:list={['entry', e.href && 'entry--link']}>
                  {e.context && <p class="context">{e.context}</p>}
                  <h3 class="title">{e.title}</h3>
                  <ul class="tech" aria-label="Tech">
                    {e.tech.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                  <p class="summary">{e.summary}</p>
                  {e.href && <span class="cta">{sections.projects.cta}</span>}
                </Card>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  /* Mobile: rail on the left, period above each card. */
  .track {
    position: relative;
    list-style: none;
    padding: 0;
  }
  .track::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1rem;
    width: 2px;
    background: color-mix(in oklab, var(--color-accent) 35%, transparent);
  }
  .item {
    position: relative;
    padding-left: 3rem;
  }
  .item + .item {
    margin-top: 2.5rem;
  }
  .num {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    width: 2.125rem;
    height: 2.125rem;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-accent);
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .period {
    min-height: 2.125rem;
    display: flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .entry {
    display: block;
    margin-top: 0.75rem;
    padding: 1.25rem 1.375rem 1.375rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 18%, transparent);
    border-left: 3px solid var(--color-accent);
    border-radius: 1.05rem 1.05rem 1.05rem 0.35rem;
    background: color-mix(in oklab, var(--color-surface) 90%, transparent);
    box-shadow: var(--shadow-card);
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s var(--ease-out-soft);
  }
  .entry--link:hover,
  .entry--link:focus-visible {
    border-top-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    border-bottom-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    border-right-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
    box-shadow: var(--shadow-window);
    transform: translateY(-2px);
  }
  .context {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .title {
    margin-top: 0.5rem;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-fg);
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.875rem;
    list-style: none;
    padding: 0;
  }
  .tech li {
    padding: 0.2rem 0.65rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 22%, transparent);
    border-radius: 999px;
    background: var(--color-surface-2);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .summary {
    margin-top: 0.875rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .cta {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .cta::after {
    content: '→';
    display: inline-block;
    margin-left: 0.35rem;
    transition: transform 0.25s var(--ease-out-soft);
  }
  .entry--link:hover .cta::after {
    transform: translateX(4px);
  }

  /* Phones: each entry snaps to the middle of the screen, like the reference. */
  @media (max-width: 767px) and (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    .item {
      scroll-snap-align: center;
    }
  }

  /* Desktop: centered rail, cards alternate left and right with the period on the outer side. */
  @media (min-width: 768px) {
    .track::before {
      left: 50%;
      transform: translateX(-1px);
    }
    .item {
      display: grid;
      grid-template-columns: 1fr 4rem 1fr;
      padding-left: 0;
    }
    .item + .item {
      margin-top: 2.5rem;
    }
    .num {
      position: relative;
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
      margin-top: 1.25rem;
    }
    .side {
      grid-row: 1;
      display: grid;
      grid-template-columns: 5.5rem 1fr;
      align-items: start;
    }
    .item--left .side {
      grid-column: 1;
    }
    .item--right .side {
      grid-column: 3;
      grid-template-columns: 1fr 5.5rem;
    }
    .period {
      margin-top: 1.25rem;
      padding-right: 0.75rem;
    }
    .item--right .period {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
      text-align: right;
      padding-right: 0;
      padding-left: 0.75rem;
    }
    .item--right .entry {
      grid-column: 1;
      grid-row: 1;
      border-left: 1px solid color-mix(in oklab, var(--color-accent) 18%, transparent);
      border-right: 3px solid var(--color-accent);
      border-radius: 1.05rem 1.05rem 0.35rem 1.05rem;
    }
    .item--right .entry--link:hover,
    .item--right .entry--link:focus-visible {
      border-left-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
      border-right-color: var(--color-accent);
    }
    .entry {
      margin-top: 0;
    }
  }
</style>
